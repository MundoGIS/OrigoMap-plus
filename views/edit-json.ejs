<!DOCTYPE html>
<html>
<head>
  <%- include('./layouts/head'); -%>
  <title>Editar JSON</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/jsoneditor/10.0.0/jsoneditor.min.css" rel="stylesheet" type="text/css">
</head>

<body>
  <div class="container mt-5">
    <section class="section">
      <h1 class="title">Redigera JSON: <%= fileName %></h1>
      <div id="jsoneditor" class="jsoneditor-container" style="height: 400px;"></div>

      <div class="field mt-4">
        <button class="button is-primary" onclick="saveJson()">Spara</button>
      </div>
    </section>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jsoneditor/10.0.0/jsoneditor.min.js"></script>
  <script>
    const fileName = '<%= fileName %>';
    const json = JSON.parse(decodeURIComponent('<%= json %>'));
    const container = document.getElementById('jsoneditor');

    const options = {
      mode: 'tree',
      modes: ['code', 'form', 'text', 'tree', 'view'],
      search: true,
      history: true
    };

    const editor = new JSONEditor(container, options);
    editor.set(json);

    function saveJson() {
      const editedJson = editor.get();

      fetch(`/origoadmin/save-json?file=${encodeURIComponent(fileName)}`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(editedJson)
      })
      .then(response => {
        if (response.ok) {
          alert('JSON saved successfully!');
          document.getElementById('json-editor-section').style.display = 'none';
        } else {
          console.error('Failed to save JSON');
        }
      })
      .catch(error => {
        console.error('Error saving JSON:', error);
        alert('Error saving JSON. See console for details.');
      });
    }
  </script>
</body>
</html>
