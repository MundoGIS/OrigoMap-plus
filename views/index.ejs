<!DOCTYPE html>
<html lang="sv">
        <head>
            <%- include('./layouts/head'); -%>
            <title>Origo Plus | Kartportal</title>
            <link rel="stylesheet" href="/public/css/style_origo.css">
            <style>
                /* Estilos básicos */
                .image-container {
                    width: 256px;
                    height: 256px;
                    overflow: hidden;
                    margin: 1rem auto;
                    border-radius: 15px;
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                    border: 1px solid #dbdbdb;
                }

                .image-container img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform 0.3s ease, box-shadow 0.3s ease;
                }

                .image-container img:hover {
                    transform: scale(1.05);
                    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
                }

                .columns.is-multiline .column {
                    display: flex;
                    padding: 1rem;
                }

                .column .box {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: flex-start;
                    text-align: center;
                    width: 100%;
                    height: 100%;
                    transition: box-shadow 0.3s ease;
                    box-shadow: 0 2px 3px rgba(10, 10, 10, 0.1), 0 0 0 1px rgba(10, 10, 10, 0.1);
                }

                .column .box:hover {
                    box-shadow: 0 6px 12px rgba(10, 10, 10, 0.15);
                }

                .box-content {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    width: 100%;
                    flex-shrink: 0;
                    /* Evita que se encoja */
                }

                .box .title {
                    margin-bottom: 0.75rem;
                    font-size: 1.2rem;
                    line-height: 1.3;
                }

                .box .description {
                    margin-top: 1rem;
                    flex-grow: 1;
                    /* Ocupa espacio vertical restante */
                    font-size: 0.9rem;
                    color: #555;
                    width: 95%;
                    text-align: left;
                    /* --- Estilos Clave para Ajuste de Texto --- */
                    overflow-wrap: break-word;
                    word-wrap: break-word;
                    word-break: break-word;
                    /* Opcional: break-all si lo anterior falla */
                    white-space: normal;
                    overflow-y: auto;
                    /* Scroll si es muy alto */
                    max-height: 150px;
                    /* Altura máxima para descripción */
                    padding-bottom: 1rem;
                    /* Espacio al final */
                }

                /* Estilos para elementos dentro de la descripción */
                .box .description p {
                    margin-bottom: 0.5em;
                }

                .box .description pre,
                .box .description code {
                    white-space: pre-wrap !important;
                    word-wrap: break-word !important;
                    overflow-wrap: break-word !important;
                    word-break: break-all;
                    display: block;
                    max-width: 100%;
                    overflow-x: auto;
                    background-color: #f1f1f1;
                    padding: 0.5em;
                    border-radius: 3px;
                }

                .box .description img,
                .box .description table {
                    max-width: 100% !important;
                    height: auto !important;
                    display: block;
                    margin: 0.5em auto;
                }

                .box .description a {
                    overflow-wrap: break-word;
                    word-break: break-all;
                }

                .button-container {
                    display: flex;
                    justify-content: center;
                    gap: 10px;
                    margin-bottom: 1rem;
                    flex-wrap: wrap;
                }

                .portal-section {
                    padding-top: 1.5rem;
                }

                .modal .modal-content {
                    width: 90%;
                    max-width: 500px;
                }

                .portal-brand {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 1rem;
                    margin: 0 auto 1.5rem;
                }

                .portal-brand__origo {
                    display: grid;
                    place-items: center;
                    width: 190px;
                    height: 76px;
                    padding: 1rem;
                    background: #183847;
                    border-radius: 6px;
                }

                .portal-brand__origo img {
                    display: block;
                    width: 100%;
                    max-height: 46px;
                    object-fit: contain;
                }

                .portal-brand__company {
                    display: block;
                    width: 116px;
                    height: 76px;
                    object-fit: cover;
                    object-position: center;
                    border-radius: 6px;
                }

                .map-grid {
                    justify-content: center;
                    align-items: stretch;
                }

                .map-grid > .column {
                    display: flex;
                    justify-content: center;
                }

                .map-grid .box {
                    max-width: 430px;
                }

                @media (max-width: 480px) {
                    .portal-brand { gap: 0.5rem; }
                    .portal-brand__origo { width: 160px; height: 64px; }
                    .portal-brand__company { width: 96px; height: 64px; }
                }
            </style>
        </head>

        <body>
            <% if (!(isAuthenticated && userRole === 'admin')) { %>
                <%- include('./layouts/flash-messages'); -%>
            <% } %>
            <% if (isAuthenticated && userRole==='admin' ) { %>
                <%# Header solo para admin logueado %>
                    <%- include('./layouts/header'); -%>
                        <% } %>

                            <section class="section portal-section">
                                <div class="container">
                                    <div class="columns is-centered">
                                        <div class="column is-three-quarters has-text-centered">
                                            <div class="portal-brand" aria-label="Origo Plus by MundoGIS">
                                                <div class="portal-brand__origo">
                                                    <img src="/public/images/logo.png" alt="Origo Plus">
                                                </div>
                                                <img class="portal-brand__company" src="<%= siteLogoPath %>" alt="Site logo">
                                            </div>
                                                        <div class="button-container">
                                                            <% if (!isAuthenticated) { %>
                                                                <button id="loginBtn"
                                                                    class="button is-primary">Login</button>
                                                            <% } else { %>
                                                                    <a href="/logout" class="button is-light">Logout</a>
                                                            <% } %>
                                                            <% if (userRole==='admin' ) { %>
                                                                    <a href="/origoadmin/origo-admin" class="button is-link">Admin Panel</a>
                                                            <% } %>


                                                              <% (typeof menuSections !== 'undefined' ? menuSections : []).forEach(item => { %>
                                                                    <a href="/sections/<%= item.slug %>" class="button is-info is-light"><%= item.title %></a>
                                                              <% }) %>
                                                        </div>
                                        </div>
                                    </div>

                                    <div class="columns is-multiline is-justify-content-center mt-4 map-grid">

                                        <% if (isAuthenticated && (userRole==='intern' || userRole==='admin' )) { %>
                                            <div class="column is-4-desktop is-6-tablet">
                                                <div class="box">
                                                    <div class="box-content">
                                                        <h2 class="title is-5">Intern base 2D Map</h2>
                                                        <div class="image-container">
                                                            <a href="/OrigoMap/index" title="Open Default 2D Map"> <img
                                                                    src="/public/images/OrigoMaps.png"
                                                                    alt="Default Origo Map"></a>
                                                        </div>
                                                    </div>
                                                    <p class="description">Internal 2D map using Origo default config.
                                                    </p>
                                                </div>
                                            </div>
                                            <% } %>
                                                <%# La variable 'publishedMaps' ya viene filtrada (o completa) desde
                                                    app.js %>
                                                    <% if (typeof publishedMaps !=='undefined' && publishedMaps.length>
                                                        0) { %>
                                                        <% publishedMaps.forEach(map=> { %>
                                                            <div class="column is-4-desktop is-6-tablet">
                                                                <div class="box">
                                                                    <div class="box-content">
                                                                        <h2 class="title is-5">
                                                                            <%= map.title %>
                                                                        </h2>
                                                                        <div class="image-container">
                                                                            <a href="/OrigoMap/<%= map.name %>"
                                                                                title="Open <%= map.title %> Map">
                                                                                <img src="/public/images/OrigoMaps.png"
                                                                                    alt="<%= map.title %> Map"
                                                                                    onerror="this.onerror=null; this.src='/public/images/OrigoMaps_default.png';">
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                    <div class="description">
                                                                        <%- map.description
                                                                            || '<p>No description available.</p>' %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <% } else if (!isAuthenticated) { %>
                                                                    <div class="column is-full">
                                                                        <div
                                                                            class="notification is-info has-text-centered">
                                                                            Inga offentliga kartor finns ännu.
                                                                            Logga in för att se privata kartor.
                                                                        </div>
                                                                    </div>
                                                                    <% } else if (isAuthenticated && (!publishedMaps ||
                                                                        publishedMaps.length===0)) { %>
                                                                        <div class="column is-full">
                                                                            <div
                                                                                class="notification is-light has-text-centered">
                                                                                Inga fler publicerade kartor hittades.
                                                                                Använd administrationspanelen för att publicera kartor.
                                                                            </div>
                                                                        </div>
                                                                        <% } %>
                                    </div>
                                </div>
                            </section>

                            <%- include('./layouts/footer'); -%>

                            <div id="loginModal" class="modal">
                                <div class="modal-background" onclick="closeModal()"></div>
                                <div class="modal-content">
                                    <div class="box">
                                        <button class="delete" aria-label="close" id="closeModalButton"></button>
                                        <h2 class="title has-text-centered">Logga in</h2>
                                        <form id="loginForm" action="/login" method="POST" autocomplete="off">
                                            <div class="field">
                                                <label class="label" for="username">Användarnamn</label>
                                                <div class="control has-icons-left">
                                                    <input class="input" type="text" id="username" name="username"
                                                        placeholder="Användarnamn" required autocomplete="username">
                                                    <span class="icon is-small is-left"><i
                                                            class="fas fa-user"></i></span>
                                                </div>
                                            </div>
                                            <div class="field">
                                                <label class="label" for="password">Lösenord</label>
                                                <div class="field has-addons">
                                                    <div class="control is-expanded has-icons-left">
                                                        <input class="input" type="password" id="password" name="password"
                                                            placeholder="Lösenord" required autocomplete="current-password">
                                                        <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
                                                    </div>
                                                    <div class="control">
                                                        <button class="button" type="button" data-password-toggle="password" aria-label="Visa lösenord" aria-pressed="false">
                                                            <span class="icon"><i class="fas fa-eye" aria-hidden="true"></i></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="field">
                                                <label class="checkbox">
                                                    <input type="checkbox" name="rememberMe" value="on">
                                                    Kom ihåg mig i 60 dagar
                                                </label>
                                            </div>
                                            <div class="field is-grouped">
                                                <div class="control"><button class="button is-primary"
                                                        type="submit">Logga in</button></div>
                                                <div class="control"><button class="button is-light" type="button"
                                                        id="cancelLoginButton">Avbryt</button></div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <script>
                                // Login Modal Script
                                const loginBtn = document.getElementById('loginBtn');
                                const loginModal = document.getElementById('loginModal');
                                const closeModalButton = document.getElementById('closeModalButton');
                                const cancelLoginButton = document.getElementById('cancelLoginButton');
                                const modalBackground = loginModal?.querySelector('.modal-background');

                                const closeModal = () => { if (loginModal) loginModal.classList.remove('is-active'); }

                                if (loginBtn && loginModal) {
                                    // Usa la variable directamente pasada a la vista
                                    const isAuthenticatedForScript = <%= isAuthenticated ? 'true' : 'false' %>;
                                    if (!isAuthenticatedForScript) {
                                        loginBtn.addEventListener('click', () => {
                                            console.log("Login button clicked, attempting to open modal."); // Log para depurar click
                                            loginModal.classList.add('is-active');
                                        });
                                    }
                                } else if (!loginBtn && !<%= isAuthenticated ? 'true' : 'false' %>) {
                                    // Log si el botón no se encuentra cuando debería (usuario no autenticado)
                                    console.warn("Login button (#loginBtn) not found in DOM when user is logged out.");
                                }

                                if (closeModalButton) closeModalButton.addEventListener('click', closeModal);
                                if (cancelLoginButton) cancelLoginButton.addEventListener('click', closeModal);
                                if (modalBackground) modalBackground.addEventListener('click', closeModal);

                                document.querySelectorAll('[data-password-toggle]').forEach(button => {
                                    button.addEventListener('click', () => {
                                        const passwordInput = document.getElementById(button.dataset.passwordToggle);
                                        const showPassword = passwordInput.type === 'password';
                                        passwordInput.type = showPassword ? 'text' : 'password';
                                        button.setAttribute('aria-pressed', String(showPassword));
                                        button.setAttribute('aria-label', showPassword ? 'Dölj lösenord' : 'Visa lösenord');
                                        button.querySelector('i').className = showPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
                                    });
                                });
                            </script>
                            <script
                                src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
        </body>

</html>