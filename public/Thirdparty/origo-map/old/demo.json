          {
            "name": "googlestreet",
            "tooltipText": "Google street view",
            "method": "LatLon",
            "url": "https://www.google.com/maps/@?api=1&map_action=pano&viewpoint={{LAT}},{{LON}}&heading=-45&pitch=10&fov=80",
            "buttonImage": "/img/png/google_street_view.png"
          },
          {
            "name": "maillary",
            "tooltipText": "Mapillary",
            "method": "LatLon",
