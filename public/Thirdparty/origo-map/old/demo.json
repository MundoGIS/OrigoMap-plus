        "url": "https://karta.rabbalshedekraft.se/origoserver/search",
        "layerNameAttribute": "TYPE",
        "idAttribute": "GID",
        "searchAttribute": "NAMN",
        "geometryAttribute": "GEOM",
        "hintText": "Sök projekt..."
      }
    },
    {
      "name": "draw",
      "options": {
        "buttonText": "Rita",
        "drawTools": {
          "Polygon": [
            "freehand",
            "box"
          ],
          "LineString": [
            "freehand"
          ]
        },
        "showAttributeButton": true,
        "showDownloadButton": true,
        "showSaveButton": true,
        "multipleLayers": true,
        "queryable": false,
        "removable": true,
        "exportable": true,
        "layerTitle": "Ritlager",
        "groupTitle": "Ritlåda",
        "groupName": "rit"
      }
    },
    {
      "name": "sharemap",
      "options": {
        "storeMethod": "saveStateToServer",
        "serviceEndpoint": "https://karta.sundsvall.se/mapstate"
      }
    }
