            "buttonImage": "/img/png/mapillary.png"
          },
          {
            "name": "osc",
            "tooltipText": "OpenStreetCam",
            "method": "LatLon",
            "url": "https://openstreetcam.org/map/@{{LAT}},{{LON}},18z",
            "buttonImage": "/img/png/osc.png"
          },
          {
            "name": "osm",
            "tooltipText": "OpenStreetMap",
            "method": "LatLon",
            "url": "https://www.openstreetmap.org/#map=17/{{LAT}}/{{LON}}",
